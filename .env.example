# ==============================================================================
# NIRVANA PLATFORM ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure with your authentic credentials.
# Nirvana operates with built-in resilient offline & local fallbacks if keys are not yet provided.

# 1. Google Gemini API
# Generates reasoning, contextual companion dialogue, gentle reflections, and memory extraction
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase (PostgreSQL Database, Auth & Row Level Security)
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Inworld AI (Natural Multimodal Voice Experience)
# Optional: If omitted, Nirvana seamlessly falls back to high-clarity browser-native Web Speech
INWORLD_API_KEY=your_inworld_api_key_here
INWORLD_SCENE_ID=your_inworld_scene_id_here

# 4. Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
